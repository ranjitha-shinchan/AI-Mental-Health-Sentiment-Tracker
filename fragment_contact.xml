<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    tools:context="com.example.mentalhealth.ContactFragment">

    <!-- RecyclerView to show contact list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewContacts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/sendLocationBtn"
        android:paddingBottom="80dp" />

    <!-- Send Location Button at bottom -->
    <Button
        android:id="@+id/sendLocationBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Send Location"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/purple_500"
        android:layout_marginBottom="12dp"
        android:elevation="4dp" />

    <!-- FloatingActionButton above the Send Location button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddContact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/sendLocationBtn"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Add Contact"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/purple_500"
        app:elevation="6dp"
        app:maxImageSize="24dp" />
</RelativeLayout>
